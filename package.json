{
  "name": "horus-heresy-archive",
  "private": true,
  "scripts": {
    "build": "npm run check:data && node tools/build-site.mjs",
    "check:data": "node tools/build-catalogue.mjs --check && node tools/reconcile-catalogue.mjs --check && node tools/validate-data.mjs",
    "check:browser": "node tools/ui-checks.mjs",
    "check:accessibility": "node tools/accessibility-checks.mjs",
    "check:engines": "node tools/cross-browser-smoke.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "1.63.0"
  }
}
